# Variables de entorno para producción — configurar en Cloudflare Pages
# (Dashboard > Workers & Pages > magico-ensueno > Settings > Environment variables).
# Este archivo es solo documentación, no se lee en runtime.
# Para desarrollo local con wrangler, los valores reales van en .dev.vars (gitignored).

# --- Mercado Pago (checkout + webhook, ver functions/api/manychat.ts y functions/api/webhook-mp.ts) ---
# Access token de producción de la aplicación del cliente en MP Developers.
MP_ACCESS_TOKEN=
# "Clave secreta" del webhook (MP > Tus integraciones > la app > Webhooks).
MP_WEBHOOK_SECRET=

# --- ManyChat (ver functions/api/manychat.ts y functions/api/webhook-mp.ts) ---
# Secreto compartido: valida X-ManyChat-Secret entrante Y se usa como Bearer
# al llamar la API de ManyChat desde el webhook de MP.
MANYCHAT_API_KEY=
# flow_ns del flow de confirmación que se dispara cuando se aprueba el pago.
MANYCHAT_CONFIRMATION_FLOW_NS=

# --- Airbnb iCal sync (ver functions/api/admin/sync-airbnb.ts) ---
# Una var por alojamiento: AIRBNB_ICS_URL_<id>. Solo hace falta configurar
# las que existan — el sync ignora los alojamientos sin URL.
AIRBNB_ICS_URL_1=
AIRBNB_ICS_URL_2=
AIRBNB_ICS_URL_3=

# --- Panel admin (ver functions/_lib/authGuard.ts, functions/api/admin/login.ts) ---
# Secreto para firmar/verificar la cookie de sesión del panel de reservas.
SESSION_SECRET=

# --- Login del CMS (Decap) vía GitHub OAuth (ver functions/auth.ts, functions/callback.ts) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Campaña de reforestación (datos públicos mostrados en /reforestacion) ---
# Usar una cuenta dedicada del proyecto. No guardar aquí datos privados ni credenciales.
VITE_REFORESTATION_ALIAS=pueblo-magico
VITE_REFORESTATION_ACCOUNT_HOLDER=Diego Epelman
# Opcional: si queda vacío, la landing muestra únicamente el alias.
VITE_REFORESTATION_CBU=
# Total recaudado confirmado, en pesos argentinos. Actualizar y volver a desplegar.
VITE_REFORESTATION_RAISED_AMOUNT=75000
VITE_REFORESTATION_RAISED_AMOUNT_USD=50
