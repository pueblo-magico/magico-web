# Variables de entorno para producción — configurar en Cloudflare Pages
# (Dashboard > Workers & Pages > magico-ensueno > Settings > Environment variables).
# Este archivo es solo documentación, no se lee en runtime.
# Para desarrollo local con wrangler, los valores reales van en .dev.vars (gitignored).

# --- Mercado Pago (checkout + webhook, ver functions/api/manychat.ts y functions/api/webhook-mp.ts) ---
# Access token de producción de la aplicación del cliente en MP Developers.
MP_ACCESS_TOKEN=
# Interruptor server-side del checkout público. Mantener false hasta configurar
# credenciales sandbox en preview y validar el flujo completo.
MP_CHECKOUT_ENABLED=false
# "Clave secreta" del webhook (MP > Tus integraciones > la app > Webhooks).
MP_WEBHOOK_SECRET=
# Transferencia directa a la cuenta de Mercado Pago. Estos datos se muestran
# sólo después de crear una reserva. La conciliación usa DNI + importe + moneda;
# cualquier coincidencia ausente o ambigua queda para revisión manual.
MP_TRANSFER_ENABLED=false
MP_TRANSFER_ALIAS=
MP_TRANSFER_CVU=
MP_TRANSFER_ACCOUNT_HOLDER=
# Secreto independiente de 32+ caracteres para guardar un HMAC del DNI y
# conciliar notificaciones sin persistir el documento completo.
PAYMENT_RECONCILIATION_SECRET=

# --- ManyChat legado (ver functions/api/manychat.ts) ---
# Secreto generado por nosotros para validar X-ManyChat-Secret en solicitudes
# entrantes. Usar valores diferentes en preview y producción.
MANYCHAT_INBOUND_SECRET=
# Variables salientes legacy. El flujo nuevo de reservas y pagos no las usa:
# genera intenciones independientes del canal. No configurarlas para el MVP.
MANYCHAT_API_KEY=
# Mantener false si todavía existe una configuración histórica en Cloudflare.
MANYCHAT_NOTIFICATIONS_ENABLED=
MANYCHAT_CONFIRMATION_FLOW_NS=

# --- Airbnb iCal sync (ver functions/api/admin/sync-airbnb.ts) ---
# Una var por alojamiento: AIRBNB_ICS_URL_<id>. Solo hace falta configurar
# las que existan — el sync ignora los alojamientos sin URL.
AIRBNB_ICS_URL_1=
AIRBNB_ICS_URL_2=
AIRBNB_ICS_URL_3=

# --- Panel admin (ver functions/_lib/authGuard.ts, functions/api/admin/login.ts) ---
# Secreto para firmar/verificar la cookie de sesión del panel de reservas.
SESSION_SECRET=

# --- Login del CMS (Decap) vía GitHub OAuth (ver functions/auth.ts, functions/callback.ts) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Campaña de reforestación (datos públicos mostrados en /reforestacion) ---
# Usar una cuenta dedicada del proyecto. No guardar aquí datos privados ni credenciales.
VITE_REFORESTATION_ALIAS=pueblo-magico
VITE_REFORESTATION_ACCOUNT_HOLDER=Diego Epelman
# Opcional: si queda vacío, la landing muestra únicamente el alias.
VITE_REFORESTATION_CBU=
# Total recaudado confirmado, en pesos argentinos. Actualizar y volver a desplegar.
VITE_REFORESTATION_RAISED_AMOUNT=75000

# --- Cucuru (cuentas de cobro por reserva) ---
# Los valores reales son secretos server-side: usar .dev.vars en local y
# variables cifradas de Cloudflare por ambiente. Nunca usar prefijo VITE_.
CUCURU_API_KEY=
CUCURU_COLLECTOR_ID=
CUCURU_API_BASE_URL=https://api.cucuru.com
CUCURU_WEBHOOK_HEADER_NAME=X-Cucuru-Webhook-Secret
CUCURU_WEBHOOK_SECRET=
# Base legible para alias. Preview: magico.qa; producción: magico.
CUCURU_ALIAS_PREFIX=magico.qa
# Sólo el literal true activa provisionamiento y backfill.
CUCURU_TRANSFER_ENABLED=false
# Adaptador de cuentas: real por defecto. Usar mock sólo en desarrollo/Preview.
CUCURU_PROVIDER_MODE=real
# Segunda barrera explícita: mock falla cerrado si este valor no es true.
# No configurar en producción.
CUCURU_MOCK_ALLOWED=false

# Identidad de servicio para que n8n consulte disponibilidad, cotice, cree
# reservas idempotentes y ejecute cada minuto el vencimiento de retenciones.
# Usar un valor distinto por ambiente y de al menos 24 caracteres.
N8N_INBOUND_SECRET=

# --- Outbox de integraciones (WRESERV-19) ---
# Identidad exclusiva para invocar cada minuto el dispatcher desde n8n.
# No reutilizar N8N_INBOUND_SECRET y separar Preview de Producción.
OUTBOX_DISPATCH_SECRET=
# Debe permanecer false hasta configurar y validar el consumidor de Preview.
INTEGRATION_OUTBOX_ENABLED=false
# Endpoint HTTPS server-side (por ejemplo, un webhook autenticado de n8n).
INTEGRATION_EVENTS_WEBHOOK_URL=
# Secreto Bearer distinto del secreto que invoca el dispatcher.
INTEGRATION_EVENTS_WEBHOOK_SECRET=
