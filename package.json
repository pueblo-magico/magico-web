{
  "name": "magico-ensueno",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:reservas": "node --test tests/reservas/*.test.ts",
    "test:reservas:coverage": "node --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=90 --test tests/reservas/*.test.ts",
    "test:reservas:recovery": "node scripts/reservas/recovery-drill.mjs",
    "test:reservas:cutover": "node --test tests/cloudflare/production-deploy-gate.test.mjs tests/cloudflare/cutover-controls.test.mjs",
    "test:cloudflare-cleanup": "node --test tests/cloudflare/*.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-pdf/renderer": "^4.3.2",
    "cropperjs": "^2.1.0",
    "html2pdf.js": "^0.13.0",
    "i18next": "^26.0.8",
    "lucide-react": "^0.344.0",
    "marked": "^17.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/node": "^25.0.2",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "critters": "^0.0.23",
    "lighthouse": "^13.1.0",
    "playwright": "^1.59.1",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^7.2.7",
    "vite-plugin-pwa": "^1.2.0"
  }
}
