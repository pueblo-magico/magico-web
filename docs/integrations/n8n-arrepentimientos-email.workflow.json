        "emailType": "html",
        "message": "={{ (() => { const d=$json.data||{}; const lang=d.idioma==='en'?'en':'es'; const raw=String(d.cuerpo||'').replace(/\\\\n/g,'\\n'); const esc=(v)=>String(v||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;'); const states=new Map([['recibida',{label:'RECIBIDA',fg:'#175cd3',bg:'#eff8ff',border:'#b2ddff'}],['en_revision',{label:'EN REVISIÓN',fg:'#b54708',bg:'#fffaeb',border:'#fedf89'}],['resuelta',{label:'RESUELTA',fg:'#027a48',bg:'#ecfdf3',border:'#abefc6'}],['rechazada',{label:'RECHAZADA',fg:'#b42318',bg:'#fef3f2',border:'#fecdca'}]]); const state=states.get(String(d.estado||'').toLowerCase())||null; const human=String(d.mensaje_humano||'').trim(); const code=String(d.codigo||'').trim(); const hit=raw.match(/https?:\\/\\/[^\\s]+/); const url=hit?hit[0]:''; const route=url.includes('/reserva-confirmada')?'confirmed':url.includes('/reserva-fallida')?'closed':'pending'; const ctaLabels=new Map([['es.pending','Ver mi reserva y completar la seña'],['es.confirmed','Ver mi reserva confirmada'],['es.closed','Ver estado de la reserva'],['en.pending','View my booking and complete the deposit'],['en.confirmed','View my confirmed booking'],['en.closed','View booking status']]); const helps=new Map([['es.pending','Si ya realizaste el pago, no necesitás hacer nada: te avisaremos cuando se acredite. Ante cualquier duda, respondé este email o escribinos por WhatsApp.'],['es.confirmed','Tu reserva está confirmada. Guardá este email y usá el botón para consultar todos los detalles. Si necesitás ayuda, respondé este email o escribinos por WhatsApp.'],['es.closed','Esta reserva ya no está pendiente. Si necesitás más información, respondé este email o escribinos por WhatsApp.'],['en.pending','If you have already paid, no further action is required: we will let you know once it is credited. If you need help, reply to this email or contact us on WhatsApp.'],['en.confirmed','Your booking is confirmed. Keep this email and use the button to view all details. If you need help, reply to this email or contact us on WhatsApp.'],['en.closed','This booking is no longer pending. If you need more information, reply to this email or contact us on WhatsApp.']]); const lines=raw.replace(url,'').split(/\\n+/).map((v)=>v.trim()).filter(Boolean); const intro=esc(lines.shift()||(lang==='en'?'We have an update about your booking.':'Tenemos novedades sobre tu reserva.')); const details=lines.map((line)=>{const i=line.indexOf(':'); if(i>0&&!line.slice(i+1).trim())return ''; const value=i>0?line.slice(i+1).trim().replace(/\\.$/,''):''; return i>0?'<p style=\"margin:0;padding:9px 0;border-bottom:1px solid #eaecf0;font-size:14px;color:#667085;\"><span>'+esc(line.slice(0,i))+':</span> <strong style=\"float:right;color:#0f2f26;\">'+esc(value)+'</strong></p>':'<p style=\"margin:8px 0;color:#344054;font-size:14px;\">'+esc(line)+'</p>';}).join(''); const cta=url?'<p style=\"margin:28px 0 12px;text-align:center;\"><a href=\"'+esc(url)+'\" style=\"display:inline-block;padding:14px 24px;border-radius:999px;background:#006c4c;color:#fff;text-decoration:none;font-weight:700;\">'+ctaLabels.get(lang+'.'+route)+'</a></p><p style=\"margin:0;text-align:center;color:#667085;font-size:11px;word-break:break-all;\"><a href=\"'+esc(url)+'\" style=\"color:#006c4c;\">'+esc(url)+'</a></p>':''; const status=state?'<div style=\"padding:20px;border:1px solid '+state.border+';border-radius:14px;background:'+state.bg+';\"><span style=\"display:inline-block;padding:6px 10px;border-radius:999px;background:#fff;color:'+state.fg+';font-size:12px;font-weight:800;letter-spacing:1.4px;\">'+state.label+'</span><h2 style=\"margin:14px 0 4px;color:#1d2939;font-family:Georgia,serif;font-size:23px;line-height:1.3;\">'+intro+'</h2>'+(code?'<p style=\"margin:0;color:#667085;font-size:13px;\">Solicitud '+esc(code)+'</p>':'')+'</div>':''; const personal=state&&human?'<div style=\"margin-top:22px;padding:20px 22px;border-left:4px solid #d4a72c;border-radius:0 12px 12px 0;background:#fbf7ec;\"><div style=\"margin-bottom:9px;color:#7a5b08;font-size:11px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;\">Mensaje del equipo de Pueblo Mágico</div><p style=\"margin:0;color:#344054;font-family:Georgia,serif;font-size:17px;line-height:1.65;font-style:italic;\">“'+esc(human).replace(/\\n/g,'<br>')+'”</p></div>':''; const content=state?status+personal:'<p style=\"margin:0 0 20px;font-size:18px;line-height:1.5;color:#1d2939;\">'+intro+'</p>'+details+cta; const help=state?(lang==='en'?'If you need more information, reply to this email or contact us on WhatsApp.':'Si necesitás más información, respondé este email o escribinos por WhatsApp.'):helps.get(lang+'.'+route); const header=lang==='en'?'Your stay in the mountains':'Tu estadía en la montaña'; const footer=lang==='en'?'Pueblo Mágico · Nature that inspires':'Pueblo Mágico · Naturaleza que inspira'; return '<div style=\"padding:28px 12px;background:#f6f4ef;font-family:Arial,sans-serif;\"><div style=\"max-width:600px;margin:auto;background:#fff;border:1px solid #e5e7eb;border-radius:18px;overflow:hidden;\"><div style=\"padding:26px 30px;background:#005b43;color:#fff;\"><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;\">Pueblo Mágico</div><h1 style=\"margin:10px 0 0;font-family:Georgia,serif;font-size:28px;\">'+header+'</h1></div><div style=\"padding:28px 30px;\">'+content+'<p style=\"margin:26px 0 0;color:#667085;font-size:13px;line-height:1.5;\">'+help+'</p></div><div style=\"padding:16px;background:#faf9f6;color:#667085;font-size:12px;text-align:center;\">'+footer+'</div></div></div>'; })() }}",
        "options": {}
